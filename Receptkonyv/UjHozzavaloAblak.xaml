<Window x:Class="Receptkonyv.UjHozzavaloAblak"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új Hozzávaló" Height="200" Width="350" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="Megnevezés:" FontWeight="Bold" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="tbNev" VerticalContentAlignment="Center" Margin="5" Grid.Row="0" Grid.Column="1"/>

        <Label Content="Mennyiség:" FontWeight="Bold" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
        <TextBox x:Name="tbMennyiseg" VerticalContentAlignment="Center" Margin="5" Grid.Row="1" Grid.Column="1"/>

        <Button x:Name="btMuvelet" Content="Hozzáadás" Grid.Row="2" Grid.ColumnSpan="2" Width="120" Height="30"
                Background="#81C784" FontWeight="Bold" Click="Hozzaadas_Click"/>
    </Grid>
</Window>