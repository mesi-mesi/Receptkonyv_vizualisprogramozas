<Window x:Class="Receptkonyv.ReceptSzerkesztoAblak"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recept Szerkesztése" Height="450" Width="700" WindowStartupLocation="CenterOwner">

    <Grid x:Name="grFelulet" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="3" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <Label Content="Recept címe:" FontWeight="Bold"/>
                <TextBox Text="{Binding Cim}" VerticalContentAlignment="Center" Height="25"/>
            </StackPanel>

            <StackPanel Margin="5">
                <Label Content="Idő (perc):" FontWeight="Bold"/>
                <TextBox Text="{Binding ElkeszitesiIdo}" VerticalContentAlignment="Center" Height="25"/>
            </StackPanel>

            <StackPanel Margin="5">
                <Label Content="Kategória:" FontWeight="Bold"/>
                <ComboBox x:Name="cbKategoria" DisplayMemberPath="Megnevezes" SelectedValuePath="Id"
                          SelectedValue="{Binding KategoriaId}" Height="25"/>
            </StackPanel>
        </UniformGrid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="dgHozzavalok" Grid.Column="0" Margin="5" 
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Megnevezés" Binding="{Binding Nev}" Width="*"/>
                    <DataGridTextColumn Header="Mennyiség" Binding="{Binding Mennyiseg}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="5,0,0,0">
                <Label Content="Műveletek:" FontWeight="Bold"/>

                <Button x:Name="btHozzavaloUj" Content="Új hozzávaló" Margin="0,5" Height="30" Click="btHozzavaloUj_Click" Foreground="Black">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#E1BEE7" Offset="0.0"/>
                            <GradientStop Color="#BA68C8" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <Button x:Name="btHozzavaloModosit" Content="Módosítás" Margin="0,5" Height="30" Click="btHozzavaloModosit_Click" Foreground="Black">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FFF9C4" Offset="0.0"/>
                            <GradientStop Color="#FFF176" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <Button x:Name="btHozzavaloTorol" Content="Törlés" Margin="0,5" Height="30" Click="btHozzavaloTorol_Click" Foreground="Black">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FFCDD2" Offset="0.0"/>
                            <GradientStop Color="#E57373" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btMentes" Content="Mentés" Width="110" Height="35" Margin="10,0" IsDefault="True" Click="Mentés_Click" Foreground="Black">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#C8E6C9" Offset="0.0"/>
                        <GradientStop Color="#81C784" Offset="1.0"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <Button x:Name="btMegse" Content="Mégse" Width="110" Height="35" Margin="0" IsCancel="True" Foreground="Black">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#F5F5DC" Offset="0.0"/>
                        <GradientStop Color="#D2B48C" Offset="1.0"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>
    </Grid>
</Window>